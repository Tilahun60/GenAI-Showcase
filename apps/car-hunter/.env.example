# ============================================================
# Car Hunter - Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Database ---
DB_URL=postgresql+asyncpg://carhunter:carhunter@db:5432/carhunter

# --- Telegram Notifications ---
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Get your chat ID from @userinfobot
TELEGRAM_CHAT_ID=-1001234567890

# --- Gmail Notifications ---
# Use Gmail App Password (not your main password)
# Enable 2FA then create App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_TO=recipient@gmail.com

# --- Discord Notifications ---
# Create webhook in Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- Scraping Schedule ---
# How often to scrape (in minutes)
SCRAPE_INTERVAL_MINUTES=30

# --- Car Requirements (filters) ---
MAX_PRICE_PLN=60000
MIN_YEAR=2020
MAX_MILEAGE_KM=150000

# --- Alerting ---
# Minimum total score (0-10) to trigger notification
ALERT_SCORE_THRESHOLD=6.0
